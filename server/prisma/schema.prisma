generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  BARBER
  CUSTOMER
}

enum BookingStatus {
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Weekday {
  SATURDAY
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

model User {
  id           String   @id @default(cuid())
  name         String
  mobile       String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barberProfile BarberProfile?
  bookings      Booking[]       @relation("CustomerBookings")

  @@map("users")
}

model BarberProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio       String   @default("")
  initials  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  manageServices     Boolean @default(false)
  managePricing      Boolean @default(false)
  manageSchedule     Boolean @default(false)
  manageTimeOff      Boolean @default(false)
  blockSlots         Boolean @default(false)
  cancelOwnBookings  Boolean @default(false)
  viewCustomers      Boolean @default(false)

  // آرایه خالی = پیرو روزهای بازِ سالن (WorkingHours)؛ آرایه‌ی غیرخالی =
  // فقط همین روزها کار می‌کنه، حتی اگه سالن اون روز بازتر باشه
  workingDays Weekday[] @default([])

  services      BarberService[]
  bookings      Booking[]
  timeOffs      TimeOff[]
  leaveRequests LeaveRequest[]
  blockedSlots  BlockedSlot[]
  slotHolds     SlotHold[]
  ratings       Rating[]

  @@map("barber_profiles")
}

model Service {
  id         String   @id @default(cuid())
  title      String
  desc       String
  priceValue Int
  icon       String
  featured   Boolean  @default(false)
  createdAt  DateTime @default(now())

  barbers  BarberService[]
  bookings Booking[]

  @@map("services")
}

model BarberService {
  barberId    String
  serviceId   String
  customPrice Int?
  isActive    Boolean @default(true)

  barber  BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@map("barber_services")
}

model Booking {
  id         String        @id @default(cuid())
  customerId String
  barberId   String
  serviceId  String
  date       DateTime
  time       String
  status     BookingStatus @default(CONFIRMED)
  notes      String?
  // قیمت نهاییِ ثبت‌شده موقع رزرو (customPrice آرایشگر یا قیمت پیش‌فرض سرویس).
  // nullable چون نوبت‌های قدیمی قیمت ندارن؛ فرانت برای اون‌ها از قیمت سرویس استفاده می‌کنه.
  price      Int?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  customer User          @relation("CustomerBookings", fields: [customerId], references: [id])
  barber   BarberProfile @relation(fields: [barberId], references: [id])
  service  Service       @relation(fields: [serviceId], references: [id])
  rating   Rating?

  @@index([barberId, date])
  @@index([customerId])
  @@map("bookings")
}

enum RatingStatus {
  PENDING
  APPROVED
  REJECTED
}

// امتیاز و نظر مشتری برای یه نوبتِ تمام‌شده (COMPLETED).
// هر نوبت حداکثر یک امتیاز داره (bookingId یونیکه). فقط مشتریِ همون نوبت
// می‌تونه ثبت کنه (کنترلش تو سرویس انجام می‌شه). barberId برای محاسبه‌ی سریع
// معدل هر آرایشگر از روی خود نوبت کپی می‌شه.
// معدل و تعداد آرا همیشه عمومیه. متن comment همیشه برای خودِ آرایشگر و ادمین
// دیده می‌شه؛ برای بقیه‌ی مشتری‌ها فقط وقتی status=APPROVED عمومی می‌شه.
model Rating {
  id        String       @id @default(cuid())
  bookingId String       @unique
  barberId  String
  score     Int
  comment   String?
  status    RatingStatus @default(PENDING)
  createdAt DateTime     @default(now())

  booking Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  barber  BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId])
  @@index([status])
  @@map("ratings")
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model TimeOff {
  id       String   @id @default(cuid())
  barberId String
  date     DateTime

  barber BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, date])
  @@map("time_offs")
}

model LeaveRequest {
  id         String             @id @default(cuid())
  barberId   String
  date       DateTime
  reason     String?
  status     LeaveRequestStatus @default(PENDING)
  reviewedBy String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  barber BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@map("leave_requests")
}

// بلاک‌کردن یه اسلات ساعتیِ خاص از یه روز عادی، بدون اینکه کل روز مرخصی بشه
// (برخلاف TimeOff که کل روز رو غیرفعال می‌کنه)
model BlockedSlot {
  id        String   @id @default(cuid())
  barberId  String
  date      DateTime
  time      String
  createdAt DateTime @default(now())

  barber BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, date, time])
  @@map("blocked_slots")
}

// نگه‌داری موقت یه اسلات، از لحظه‌ای که مشتری ساعتی رو انتخاب می‌کنه تا
// لحظه‌ی ثبت نهایی نوبت (یا انصراف/رهاکردن). با انقضای expiresAt (پیش‌فرض
// ۵ دقیقه)، خودکار در همه‌ی کوئری‌های availability نادیده گرفته می‌شه —
// نیازی به job/cron جداگانه برای پاک‌سازی نیست.
model SlotHold {
  id        String   @id @default(cuid())
  barberId  String
  date      DateTime
  time      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  barber BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, date, time])
  @@index([expiresAt])
  @@map("slot_holds")
}

model SalonHoliday {
  id     String   @id @default(cuid())
  date   DateTime
  reason String?

  @@map("salon_holidays")
}

model SalonSettings {
  id      String @id @default("main")
  name    String @default("سالن آرایشی")
  address String @default("")
  phone   String @default("")

  @@map("salon_settings")
}

model WorkingHours {
  id        String  @id @default(cuid())
  day       Weekday @unique
  isOpen    Boolean @default(true)
  openTime  String  @default("09:00")
  closeTime String  @default("20:00")

  @@map("working_hours")
}