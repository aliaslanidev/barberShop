generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  BARBER
  CUSTOMER
}

enum BookingStatus {
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Weekday {
  SATURDAY
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

model User {
  id           String   @id @default(cuid())
  name         String
  mobile       String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barberProfile BarberProfile?
  bookings      Booking[]       @relation("CustomerBookings")

  @@map("users")
}

model BarberProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio       String   @default("")
  initials  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  manageServices     Boolean @default(false)
  managePricing      Boolean @default(false)
  manageSchedule     Boolean @default(false)
  manageTimeOff      Boolean @default(false)
  blockSlots         Boolean @default(false)
  cancelOwnBookings  Boolean @default(false)
  viewCustomers      Boolean @default(false)

  services      BarberService[]
  bookings      Booking[]
  timeOffs      TimeOff[]
  leaveRequests LeaveRequest[]
  blockedSlots  BlockedSlot[]

  @@map("barber_profiles")
}

model Service {
  id         String   @id @default(cuid())
  title      String
  desc       String
  priceValue Int
  icon       String
  featured   Boolean  @default(false)
  createdAt  DateTime @default(now())

  barbers  BarberService[]
  bookings Booking[]

  @@map("services")
}

model BarberService {
  barberId    String
  serviceId   String
  customPrice Int?
  isActive    Boolean @default(true)

  barber  BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@map("barber_services")
}

model Booking {
  id         String        @id @default(cuid())
  customerId String
  barberId   String
  serviceId  String
  date       DateTime
  time       String
  status     BookingStatus @default(CONFIRMED)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  customer User          @relation("CustomerBookings", fields: [customerId], references: [id])
  barber   BarberProfile @relation(fields: [barberId], references: [id])
  service  Service       @relation(fields: [serviceId], references: [id])

  @@index([barberId, date])
  @@index([customerId])
  @@map("bookings")
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model TimeOff {
  id       String   @id @default(cuid())
  barberId String
  date     DateTime

  barber BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@map("time_offs")
}

model LeaveRequest {
  id         String             @id @default(cuid())
  barberId   String
  date       DateTime
  reason     String?
  status     LeaveRequestStatus @default(PENDING)
  reviewedBy String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  barber BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@map("leave_requests")
}

// بلاک‌کردن یه اسلات ساعتیِ خاص از یه روز عادی، بدون اینکه کل روز مرخصی بشه
// (برخلاف TimeOff که کل روز رو غیرفعال می‌کنه)
model BlockedSlot {
  id        String   @id @default(cuid())
  barberId  String
  date      DateTime
  time      String
  createdAt DateTime @default(now())

  barber BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, date, time])
  @@map("blocked_slots")
}

model SalonHoliday {
  id     String   @id @default(cuid())
  date   DateTime
  reason String?

  @@map("salon_holidays")
}

model SalonSettings {
  id      String @id @default("main")
  name    String @default("سالن آرایشی")
  address String @default("")
  phone   String @default("")

  @@map("salon_settings")
}

model WorkingHours {
  id        String  @id @default(cuid())
  day       Weekday @unique
  isOpen    Boolean @default(true)
  openTime  String  @default("09:00")
  closeTime String  @default("20:00")

  @@map("working_hours")
}