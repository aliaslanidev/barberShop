// اسکیمای دیتابیس — معادل واقعیِ چیزی که الان تو lib/data/*.ts با آرایه‌های in-memory
// شبیه‌سازی شده. هر مدل زیر رو با فایل mock متناظرش مقایسه کن تا رابطه رو ببینی:
// User          -> mock-accounts.ts / mock-session.ts
// BarberProfile -> barbers.ts
// Service       -> services.ts
// Booking       -> bookings.ts + appointments.ts (این دو تو دنیای واقعی یکی هستن)
// TimeOff       -> time-off.ts
// SalonHoliday  -> holidays.ts
// SalonSettings -> salon-settings.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  BARBER
  CUSTOMER
}

enum BookingStatus {
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Weekday {
  SATURDAY
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

// --- کاربران و احراز هویت ---------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  mobile       String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barberProfile BarberProfile?
  bookings      Booking[]       @relation("CustomerBookings")

  @@map("users")
}

model BarberProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio       String   @default("")
  initials  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  manageServices     Boolean @default(false)
  managePricing      Boolean @default(false)
  manageSchedule     Boolean @default(false)
  manageTimeOff      Boolean @default(false)
  blockSlots         Boolean @default(false)
  cancelOwnBookings  Boolean @default(false)

  services  BarberService[]
  bookings  Booking[]
  timeOffs  TimeOff[]
  leaveRequests LeaveRequest[]

  @@map("barber_profiles")
}

// --- خدمات -------------------------------------------------------------------

model Service {
  id         String   @id @default(cuid())
  title      String
  desc       String
  priceValue Int
  icon       String
  featured   Boolean  @default(false)
  createdAt  DateTime @default(now())

  barbers  BarberService[]
  bookings Booking[]

  @@map("services")
}

// جدول واسط many-to-many بین آرایشگر و خدماتی که ارائه می‌ده
model BarberService {
  barberId    String
  serviceId   String
  customPrice Int? // فقط وقتی پر می‌شه که آرایشگر پرمیشن managePricing داشته باشه؛
                    // اگه null بود، قیمت نمایشی = Service.priceValue

  barber  BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@map("barber_services")
}

// --- نوبت‌ها -------------------------------------------------------------------

model Booking {
  id         String        @id @default(cuid())
  customerId String
  barberId   String
  serviceId  String
  date       DateTime
  time       String
  status     BookingStatus @default(CONFIRMED)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  customer User          @relation("CustomerBookings", fields: [customerId], references: [id])
  barber   BarberProfile @relation(fields: [barberId], references: [id])
  service  Service       @relation(fields: [serviceId], references: [id])

  @@index([barberId, date])
  @@index([customerId])
  @@map("bookings")
}

// --- مرخصی و تعطیلات -----------------------------------------------------------

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model TimeOff {
  id       String   @id @default(cuid())
  barberId String
  date     DateTime

  barber BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@map("time_offs")
}

model LeaveRequest {
  id         String             @id @default(cuid())
  barberId   String
  date       DateTime
  reason     String?
  status     LeaveRequestStatus @default(PENDING)
  reviewedBy String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  barber BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@map("leave_requests")
}

model SalonHoliday {
  id     String   @id @default(cuid())
  date   DateTime
  reason String?

  @@map("salon_holidays")
}

// --- تنظیمات سالن ---------------------------------------------------------------

model SalonSettings {
  id      String @id @default("main")
  name    String @default("سالن آرایشی")
  address String @default("")
  phone   String @default("")

  @@map("salon_settings")
}

model WorkingHours {
  id        String  @id @default(cuid())
  day       Weekday @unique
  isOpen    Boolean @default(true)
  openTime  String  @default("09:00")
  closeTime String  @default("20:00")

  @@map("working_hours")
}